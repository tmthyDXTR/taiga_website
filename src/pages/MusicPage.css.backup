/* MusicPage.css - Clean foundation */
/* Colors are centralized in index.css */

:root {
  /* Vinyl slide-out distance on hover */
  --vinyl-slide-distance: 22vw;
}

.music-page {
  min-height: 100vh;
  background: #000;
  color: var(--lime-green);
  position: relative;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
}

/* Hero section that contains vinyl */
.music-hero {
  position: relative;
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 20px; /* space for logo header */
}

/* Section Navigation - above vinyl */
.section-nav {
  position: relative;
  z-index: 30;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.8rem 1.6rem;
  padding: 0.6rem 0.8rem;
  margin-bottom: 1rem;
}

.section-nav .nav-link {
  background: transparent;
  border: none;
  color: var(--lime-green);
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
  padding: 0.1rem .2rem;
  position: relative;
}

.section-nav .nav-link:hover {
  color: var(--pink-magenta);
}

.section-nav .book-link {
  color: var(--pink-magenta);
}

.section-nav .book-link:hover {
  color: var(--lime-green);
}

/* Social Icons - beneath section nav */
.social-icons {
  display: flex;
  justify-content: center;
  gap: 1.5rem;
  margin-top: 0.5rem;
  margin-bottom: 1rem;
  position: relative;
  z-index: 35;
}

.social-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  color: var(--lime-green);
  transition: all 0.3s ease;
}

.social-icon svg {
  width: 24px;
  height: 24px;
}

.social-icon:hover {
  color: var(--pink-magenta);
  transform: scale(1.2);
}

/* Floating nav social icons */
.floating-nav-socials {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  padding: 0.5rem;
}

.floating-nav-socials a {
  font-size: 1.2rem;
  text-decoration: none;
  transition: transform 0.2s ease;
}

.floating-nav-socials a:hover {
  transform: scale(1.3);
}

/* Floating Collapsed Navigation */
.floating-nav {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.floating-nav.visible {
  opacity: 1;
  visibility: visible;
}

.floating-nav-toggle {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: var(--dark-bg);
  border: 2px solid var(--lime-green);
  color: var(--lime-green);
  font-size: 1.5rem;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.floating-nav-toggle:hover {
  background: var(--lime-green);
  color: var(--dark-bg);
}

.floating-nav-menu {
  position: absolute;
  top: 60px;
  right: 0;
  background: rgba(42, 42, 42, 0.95);
  backdrop-filter: blur(10px);
  border: 2px solid var(--lime-green);
  border-radius: 0;
  padding: 0.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 160px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: all 0.3s ease;
}

.floating-nav-menu.open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.floating-nav-link {
  background: transparent;
  border: none;
  color: var(--lime-green);
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  text-align: left;
  cursor: pointer;
  padding: 0.6rem 1rem;
  transition: all 0.2s ease;
  font-family: inherit;
  border-radius: 0;
}

.floating-nav-link:hover {
  background: var(--lime-green);
  color: var(--dark-bg);
}

.floating-nav-link.book-link {
  color: var(--pink-magenta);
}

.floating-nav-link.book-link:hover {
  background: var(--pink-magenta);
  color: white;
}

.floating-nav-divider {
  height: 1px;
  background: var(--lime-green);
  opacity: 0.3;
  margin: 0.5rem 0;
}

.floating-nav-language {
  padding: 0.5rem 0.5rem;
}

/* Adjust language switcher for floating nav */
.floating-nav-language .language-switcher {
  width: 100%;
}

.floating-nav-language .desktop-dropdown button,
.floating-nav-language .mobile-switcher button {
  background: transparent;
  border: 1px solid var(--lime-green);
  color: var(--lime-green);
  width: 100%;
  padding: 0.5rem;
  border-radius: 0;
}

.floating-nav-language .desktop-dropdown button:hover,
.floating-nav-language .mobile-switcher button:hover {
  background: var(--lime-green);
  color: var(--dark-bg);
}

.floating-nav-language .dropdown-menu {
  background: rgba(50, 50, 50, 0.98);
  border: 1px solid var(--lime-green);
}

.floating-nav-language .dropdown-menu button {
  color: var(--lime-green);
}

.floating-nav-language .dropdown-menu button:hover {
  background: var(--lime-green);
  color: var(--dark-bg);
}

/* Back to Top Button */
.back-to-top {
  position: fixed;
  bottom: 180px;
  right: 20px;
  z-index: 999;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: var(--dark-bg);
  border: 2px solid var(--lime-green);
  color: var(--lime-green);
  font-size: 1.5rem;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-to-top.visible {
  opacity: 1;
  visibility: visible;
}

.back-to-top:hover {
  background: var(--lime-green);
  color: var(--dark-bg);
  transform: translateY(-3px);
}

/* Make logo header transparent on music page */
.music-page .logo-container {
  background-color: transparent;
}

.music-page .logo-box {
  background-color: transparent;
  /* Uncomment to restore black background2 */
  /* background-color: black; */
}

/* Tint the logo with lime-green color */
.music-page .logo {
  filter: brightness(0) saturate(100%) invert(1);
  /* Apply lime-green color using CSS variable */
  /* Note: filter approximation for #d0ff00 */
  filter: brightness(0) saturate(100%) invert(93%) sepia(94%) saturate(3071%) hue-rotate(21deg) brightness(106%) contrast(106%);
}

/* Vinyl container - holds both disc and cover */
.vinyl-container {
  position: relative;
  width: 80vh;
  max-width: 600px;
  height: 80vh;
  max-height: 600px;
  aspect-ratio: 1;
  z-index: 1;
}

/* Vinyl disc - slides out on hover */
.vinyl-disc {
  position: absolute;
  top: 2%;
  left: 2%;
  width: 95%;
  height: 95%;
  background-image: url('/src/assets/images/vinyl-record.png');
  background-size: cover;
  background-position: center;
  border-radius: 50%;
  box-shadow: 
    0 3px 6px rgba(0, 0, 0, 0.5);
  z-index: 1;
  transition: transform 0.6s ease-out;
  cursor: pointer;
}

/* Insert card - starts centered behind vinyl, slides right, then back to center in front */
.insert-card {
  position: fixed;
  top: 55%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 50vw;
  height: 50vw;
  max-width: 600px;
  max-height: 600px;
  aspect-ratio: 1;
  background: linear-gradient(135deg, #3d0557 0%, #550778 50%, #2d0440 100%);
  border-radius: 4px;
  box-shadow: 
    0 4px 10px rgba(0, 0, 0, 0.3),
    0 2px 4px rgba(0, 0, 0, 0.2);
  z-index: 0;
  transition: all 0.6s ease-out 0.3s;
  padding: 2.5rem;
  overflow-y: auto;
}

/* Grain overlay for insert card */
.insert-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  opacity: 0.2;
  pointer-events: none;
  border-radius: 4px;
}

/* Close button for insert card */
.close-booklet {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: transparent;
  border: none;
  color: #ffffff;
  font-size: 2.5rem;
  line-height: 1;
  cursor: pointer;
  padding: 0.5rem;
  z-index: 10;
  transition: transform 0.2s ease, color 0.2s ease;
  opacity: 0;
  pointer-events: none;
}

.insert-card.active .close-booklet {
  opacity: 1;
  pointer-events: auto;
}

.close-booklet:hover {
  transform: scale(1.2);
  color: #ffae4a;
}

.insert-card-content {
  position: relative;
  z-index: 1;
}

.insert-card-content p {
  color: #ffffff;
  font-size: 1.2rem;
  line-height: 1.6;
  margin: 0;
  text-align: left;
  font-weight: 600;
  font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  letter-spacing: 0.02em;
}

/* Album cover - stays in place */
.album-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 2;
  box-shadow: 
    0 2px 5px rgba(0, 0, 0, 0.3),
    0 1px 2px rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 6px;
  cursor: pointer;
}

/* Desktop menu inside vinyl box */
.vinyl-menu {
  position: absolute;
  right: 2rem;
  top: 50%;
  transform: translateY(-50%);
  z-index: 6;
  display: flex;
  flex-direction: column;
  gap: 0rem;
  pointer-events: all;
  align-items: flex-end;
}

.vinyl-menu .menu-link {
  color: var(--lime-green);
  text-decoration: none;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  /* writing-mode: vertical-rl; */
  text-orientation: mixed;
  transition: all 0.3s ease;
  /* padding: 0.5rem; */
  text-align: right;
  background: transparent;
  border: none;
  cursor: pointer;
  font-family: inherit;
}

.vinyl-menu .menu-link:hover {
  color: var(--pink-magenta);
  transform: scale(1.05);
}

/* Section link button styles */
.vinyl-menu .section-link {
  padding: 0;
  margin: 0;
  font-size: 4rem;
}

/* Track names beneath the link */
.track-names {
  margin-top: 0rem;
  display: flex;
  flex-direction: column;
  gap: 0.0rem;
  align-items: flex-end;  
}

.track-names p {
  color: var(--lime-green);
  font-size: 0.6rem;
  font-weight: 400;
  margin: 0;
  /* writing-mode: vertical-rl; */
  text-orientation: mixed;
  text-align: right;
  line-height: 1;
  user-select: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
}

/* Hover trigger area - rightmost 20% of box */
.vinyl-hover-trigger {
  position: absolute;
  top: 0;
  right: 0;
  width: 20%;
  height: 100%;
  z-index: 5;
  cursor: pointer;
}

/* Desktop hover effect */
@media (min-width: 769px) {
  /* Vinyl disc slides out only when hovering tracklist link or vinyl disc */
  .vinyl-container:has(.tracklist-link:hover) .vinyl-disc,
  .vinyl-disc:hover {
    transform: translateX(var(--vinyl-slide-distance));
  }
  
  /* When vinyl disc or tracklist is hovered, activate track list link hover state */
  .vinyl-container:has(.vinyl-disc:hover) .tracklist-link,
  .tracklist-link:hover {
    color: #ffae4a;
    transform: scale(1.05);
  }
  
  /* Insert card slides out and stays when active */
  .insert-card.active {
    animation: slideOutAndBack 0.8s ease-in-out forwards;
  }
  
  /* Insert card slides back when closing */
  .insert-card.closing {
    animation: slideBackAndOut 0.8s ease-in-out forwards;
  }
  
  /* Booklet link hover state */
  .booklet-link:hover {
    color: #ffae4a;
    transform: scale(1.05);
  }
}

@keyframes slideOutAndBack {
  0% {
    transform: translate(-50%, -50%);
    z-index: 0;
  }
  50% {
    transform: translate(70%, -50%);
    z-index: 0;
  }
  100% {
    transform: translate(-50%, -50%);
    z-index: 4;
  }
}

@keyframes slideBackAndOut {
  0% {
    transform: translate(-50%, -50%);
    z-index: 4;
  }
  50% {
    transform: translate(70%, -50%);
    z-index: 4;
  }
  100% {
    transform: translate(-50%, -50%);
    z-index: 0;
    opacity: 0;
  }
}

.music-content {
  position: relative;
  z-index: 2;
  padding: 0;
  max-width: 100%;
  margin: 0;
}

.music-content h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
  text-align: center;
}

.music-content p {
  font-size: 1.1rem;
  text-align: left;
  opacity: 0.95;
}

/* Content Sections */
.music-section {
  min-height: 100vh;
  padding: 4rem 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-container {
  max-width: 1000px;
  width: 100%;
  margin: 0 auto;
}

.section-title {
  font-size: 3rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  margin-bottom: 3rem;
  text-align: center;
  text-transform: uppercase;
  color: var(--pink-magenta);
}

/* About Section */
.about-section {
  background: #000;
}

.about-content {
  max-width: 800px;
  margin: 0 auto;
}

.about-text {
  font-size: 1.3rem;
  line-height: 1.8;
  font-weight: 400;
  text-align: left;
  margin: 0;
  color: var(--lime-green);
}

/* Videos Section */
.videos-section {
  background: #000;
}

.videos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.video-item {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.video-wrapper {
  position: relative;
  padding-bottom: 56.25%; /* 16:9 aspect ratio */
  height: 0;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.5);
}

.video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.video-title {
  font-size: 1rem;
  font-weight: 600;
  color: var(--lime-green);
  letter-spacing: 0.05em;
}

.video-link {
  display: inline-block;
  margin-top: 0.4rem;
  color: var(--pink-magenta);
  font-size: 0.9rem;
  text-decoration: none;
  font-weight: 600;
}

.video-link:hover {
  color: #ff9ac9;
  text-decoration: underline;
}

/* Watch More Button */
.watch-more-btn {
  display: block;
  margin: 3rem auto 0;
  padding: 1rem 3rem;
  background: transparent;
  border: 2px solid var(--lime-green);
  color: var(--lime-green);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: inherit;
}

.watch-more-btn:hover {
  background: var(--lime-green);
  color: #000;
  transform: scale(1.05);
}

/* Gallery Section */
.gallery-section {
  background: #000;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
}

.gallery-img-wrapper {
  position: relative;
  overflow: visible;
}

.gallery-img {
  width: 100%;
  height: 250px;
  object-fit: contain;
  object-position: center;
  background: #000;
  transition: transform 0.3s ease, filter 0.3s ease;
  filter: grayscale(20%);
  display: block;
  position: relative;
  z-index: 2;
}

.gallery-img-wrapper:hover .gallery-img {
  transform: scale(1.00) translate(6px, -6px);
  filter: grayscale(0%);
}

/* Alternating lime-green borders */
.gallery-img-wrapper:nth-child(odd):hover::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8px;
  background: var(--lime-green);
  clip-path: polygon(0 15px, 15px 6px, 100% 20px, 100% 100%, 0 100%);
  z-index: 1;
}

.gallery-img-wrapper:nth-child(odd):hover::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  height: 8px;
  background: var(--lime-green);
  clip-path: polygon(0 0, 0, calc(100% - 22px) 100%, 15px 100%);
  z-index: 1;
}

/* Alternating pink-magenta borders */
.gallery-img-wrapper:nth-child(even):hover::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8px;
  background: var(--pink-magenta);
  clip-path: polygon(0 15px, 15px 6px, 100% 20px, 100% 100%, 0 100%);
  z-index: 1;
}

.gallery-img-wrapper:nth-child(even):hover::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  height: 8px;
  background: var(--pink-magenta);
  clip-path: polygon(0 0, 0, calc(100% - 22px) 100%, 15px 100%);
  z-index: 1;
}

/* Book Section */
.book-section {
  background: #000;
}

.book-content {
  text-align: center;
  padding: 3rem 2rem;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  border: 2px solid var(--pink-magenta);
  max-width: 600px;
  margin: 0 auto;
}

.book-text {
  font-size: 1.2rem;
  line-height: 1.6;
  color: var(--lime-green);
  margin-bottom: 2rem;
}

.book-button {
  display: inline-block;
  padding: 1rem 3rem;
  background: var(--pink-magenta);
  color: white;
  text-decoration: none;
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.book-button:hover {
  background: var(--lime-green);
  color: var(--dark-bg);
  transform: scale(1.05);
}

/* Creator Collab Section */
.collab-section {
  background: #000;
}

.collab-content {
  text-align: center;
  padding: 3rem 2rem;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  border: 2px solid var(--lime-green);
  max-width: 600px;
  margin: 0 auto;
}

.collab-text {
  font-size: 1.2rem;
  line-height: 1.6;
  color: var(--lime-green);
  margin-bottom: 2rem;
}

.collab-button {
  display: inline-block;
  padding: 1rem 3rem;
  background: var(--lime-green);
  color: #000;
  text-decoration: none;
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
}

.collab-button:hover {
  background: var(--pink-magenta);
  color: white;
  transform: scale(1.05);
}

/* Tickets Section */
.tickets-section {
  background: #000;
}

/* Shop Section */
.shop-section {
  background: #000;
}

/* Coming Soon placeholder */
.coming-soon {
  text-align: center;
  padding: 4rem 2rem;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(10px);
  border: 2px solid var(--pink-magenta);
}

.coming-soon p {
  font-size: 1.5rem;
  font-weight: 400;
  letter-spacing: 0.1em;
  opacity: 0.9;
  text-align: center;
  color: var(--pink-magenta);
}

/* Floating Spotify Player */
.spotify-player-floating {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: #121212;
  box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.5);
  padding: 0;
}

.spotify-player-floating iframe {
  display: block;
  border-radius: 0;
}

/* Add bottom padding to content so it doesn't get hidden behind player */
.music-content {
  padding-bottom: 0;
}

/* Responsive design */
@media (max-width: 768px) {
  /* Keep transparent header on mobile */
  .music-page .logo-container {
    background-color: transparent;
  }
  
  /* Hide vinyl disc on mobile */
  .vinyl-disc {
    display: none;
  }

  /* Section nav - mobile adjustments */
  .section-nav {
    gap: 0.8rem 1.2rem;
    padding: 1rem 0.5rem;
    margin-bottom: 0;
    margin-top: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }

  .section-nav .nav-link {
    font-size: 3rem;
    padding: 0.6rem 0.8rem;
    font-weight: 700;
  }

  
  /* Mobile: vinyl positioned differently - below navigation */
  .music-hero {
    padding-top: 5px;
  }
  
  .social-icons {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }
  
  .vinyl-container {
    position: relative; /* Change from absolute to relative */
    top: auto;
    bottom: auto;
    left: auto;
    right: auto;
    width: 100vw;
    max-width: none;
    height: calc(100vh - 300px); /* Account for header and nav space */
    max-height: none;
    margin-top: 2rem; /* Push below menu */
  }
  
  .album-cover {
    box-shadow: none;
    border: none;
    border-radius: 0;
  }
  
  .music-content {
    padding: 0;
    padding-bottom: 90px;
    margin-top: 100vh;
  }
  
  .music-section {
    padding: 3rem 1.5rem;
    min-height: auto;
  }
  
  .section-title {
    font-size: 2rem;
  }
  
  .about-text {
    font-size: 1.1rem;
  }
  
  .coming-soon p {
    font-size: 1.2rem;
  }

  /* Videos grid - single column on mobile */
  .videos-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .video-title {
    font-size: 0.9rem;
  }

  /* Gallery grid - 2 columns on mobile */
  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .gallery-img {
    height: 150px;
  }

  /* Floating Spotify player - compact on mobile */
  .spotify-player-floating {
    padding: 0;
  }

  .spotify-player-floating iframe {
    height: 80px;
  }

  /* Back to top - adjust for compact player */
  .back-to-top {
    bottom: 100px;
    right: 15px;
    width: 40px;
    height: 40px;
    font-size: 1.2rem;
  }
}

/* Extra small screens */
@media (max-width: 480px) {
  .section-nav {
    top: 70px;
    gap: 0.3rem 0.5rem;
  }

  .section-nav .nav-link {
    font-size: 1rem;
    padding: 0.3rem 0.5rem;
    letter-spacing: 0.1em;
  }

  .section-title {
    font-size: 1.5rem;
    letter-spacing: 0.1em;
  }

  .about-text {
    font-size: 1rem;
    line-height: 1.6;
  }

  .gallery-grid {
    grid-template-columns: 1fr;
  }

  .gallery-img {
    height: 200px;
  }

  .coming-soon {
    padding: 2rem 1rem;
  }

  .coming-soon p {
    font-size: 1rem;
  }
}